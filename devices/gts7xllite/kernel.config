# SPDX-License-Identifier: GPL-2.0
# Samsung Galaxy Tab S7 FE 5G. First boot: a RAM-based initramfs, messages on the bootloader's framebuffer.
CONFIG_BUILTIN_DTB_NAME="qcom/sm7225-samsung-gts7xllite"
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
# Touch bring-up: SPI controller built in, spidev for the userspace probe, uinput for the touch daemon.
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPI_SPIDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_GPIO_CDEV=y
# A Wayland compositor needs /dev/dri: simpledrm shows the bootloader framebuffer as a DRM device (card0) and replaces
# simplefb (as the pudding device does); the screen console keeps working through DRM fbdev emulation.
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_FB_SIMPLE is not set

# Rootfs over USB: squashfs through a loop device (built in) under a tmpfs overlay, so overlayfs must be built in.
CONFIG_OVERLAY_FS=y
# systemd mounts binfmt_misc and sets up additional binary formats at boot.
CONFIG_BINFMT_MISC=y

